# Site, API and media on one domain; statistics on stats.<domain>.
{$DOMAIN} {
	encode zstd gzip
	# A scraper that took the site down (2026-11-02) fakes a Google search Referer;
	# real Google sends only the origin, never the query
	@fakeGoogle header_regexp Referer ^https?://(www\.)?google\.[a-z.]+/search\?
	handle @fakeGoogle {
		respond 403
	}
	# Headless scraping browser that crawls every page (2026-11-13)
	@scraper header_regexp User-Agent (?i)lightpanda
	handle @scraper {
		respond 403
	}
	@api path /api/* /media/* /health
	handle @api {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

stats.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
}
