POSTGRES_USER=dialectio
POSTGRES_PASSWORD=dialectio
POSTGRES_DB=dialectio
DATABASE_URL=postgresql+psycopg://dialectio:dialectio@127.0.0.1:5432/dialectio
# Shared secret for the word editor (/uk/editor); editing is disabled when empty
EDITOR_TOKEN=
# Signs the control cards of the check game (any value locally)
SECRET_KEY=
# Sign in with Google: OAuth client of the Google Cloud project (empty = off); its
# redirect URI is http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Umami analytics (docker compose --profile analytics): random secret for its sessions
UMAMI_APP_SECRET=
