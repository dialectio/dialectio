POSTGRES_USER=dialectio
POSTGRES_PASSWORD=dialectio
POSTGRES_DB=dialectio
DATABASE_URL=postgresql+psycopg://dialectio:dialectio@127.0.0.1:5432/dialectio
# Shared secret for the word editor (/uk/editor); editing is disabled when empty
EDITOR_TOKEN=
# Signs the control cards of the check game (any value locally)
SECRET_KEY=
# Sign in with Google: OAuth client of the Google Cloud project (empty = off); its
# redirect URI is http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email through Brevo (transactional API key, "Transactional email" permission only);
# empty = emails go to the API's log. MAIL_TO_LOG=true logs them even with a key
BREVO_API_KEY=
MAIL_FROM=noreply@dialectio.org
# Cloudflare Turnstile secret (empty = off); the site key goes into frontend/.env.local as
# NEXT_PUBLIC_TURNSTILE_SITE_KEY. Test keys that always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=
# Umami analytics (docker compose --profile analytics): random secret for its sessions
UMAMI_APP_SECRET=
