# Copy to .env.prod on the server and fill in (never commit .env.prod).
DOMAIN=dialectio.org
POSTGRES_USER=dialectio
POSTGRES_PASSWORD=
POSTGRES_DB=dialectio
# Secret for the word editor (/uk/editor)
EDITOR_TOKEN=
# Umami: random secret; after creating the site in Umami, its tracker and id
UMAMI_APP_SECRET=
UMAMI_SRC=https://stats.dialectio.org/script.js
UMAMI_WEBSITE_ID=
# Off-server backups (deploy/backup.sh): rsync target, e.g. a Hetzner Storage Box
BACKUP_REMOTE=
BACKUP_SSH_PORT=23
# Legal notice (/imprint), required for sites addressing Germany (§5 DDG); use 
 for line
# breaks in the address
IMPRINT_NAME=
IMPRINT_ADDRESS=
IMPRINT_EMAIL=
